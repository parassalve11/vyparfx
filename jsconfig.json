{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "app/**/*.js",
    "app/**/*.jsx",
    "components/**/*.jsx",
    "lib/**/*.js",
    "data/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "reference",
    "scripts"
  ]
}